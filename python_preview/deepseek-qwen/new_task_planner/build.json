{
  "entry": "src/task_planner/main/ui/app.py",
  "name": "new-task-planner",
  "display_name": "new-task-planner",
  "version": "3.2.2",
  "publisher": "JiangDake<dakeginger@qq.com>",
  "description": "基于 LangGraph 与大语言模型的自主任务规划引擎，支持动态 DAG 编排、多模态意图识别与全流程可观测性评估（异步版）web端任务规划助手",
  "icon": "/home/dake/Documents/Hachimi.jpg",
  "pyinstaller": {
    "onefile": false,
    "windowed": false,
    "add_data": [
      "data:data",
      "src:src",
      "config:config",
      "scripts:scripts"
    ],
    "clean": true,
    "noconfirm": true
  },
  "platforms": {
    "windows": {
      "inno_setup": {
        "create_desktop_icon": true,
        "create_start_menu_icon": true,
        "allow_run_after_install": true,
        "languages": [
          "chinesesimplified",
          "english"
        ]
      }
    },
    "linux": {
      "formats": [
        "deb"
      ],
      "deb": {
        "package": "new-task-planner",
        "section": "utils",
        "priority": "optional",
        "desktop_entry": true,
        "categories": [
          "Utility"
        ]
      }
    }
  }
}
