# ============================================================
# Task Planner — 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================================

# ── DashScope API ──
DASHSCOPE_API_KEY=sk-your-real-api-key-here
DASHSCOPE_BASE_URL=
DASHSCOPE_REGION=cn-beijing
USE_MOCK_LLM=false

# ── 模型 ──
LLM_INTENT_MODEL=qwen3.7-flash-2026-07-15
LLM_PLANNER_MODEL=qwen3.7-flash-2026-07-15
LLM_NODE_MODEL=qwen3.7-flash-2026-07-15

# ── 思考模式 ──
LLM_INTENT_ENABLE_THINKING=false
LLM_PLANNER_ENABLE_THINKING=true
LLM_NODE_ENABLE_THINKING=false
LLM_THINKING_BUDGET=81920

# ── 超时/重试 ──
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=2
LLM_TASK_TOTAL_TIMEOUT=300
LLM_NODE_TIMEOUT=60
MAX_TASK_RETRIES=3

# ── MongoDB ──
MONGO_HOST=task_mongodb
MONGO_PORT=27017
MONGO_DB=task_planner_db

# ── Gradio ──
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860

# ── 日志 ──
DEBUG=true
LOG_DIR=/app/logs
LOG_FILE=task_planner.log
LOG_MAX_DAYS=7

# ── 渲染 ──
RENDER_DPI=300
RENDER_FONT=Noto Sans CJK SC
RENDER_DIR=/app/exports
RENDER_WIDTH=1200
RENDER_HEIGHT=600
DEFAULT_EXPORT_FORMAT=svg
