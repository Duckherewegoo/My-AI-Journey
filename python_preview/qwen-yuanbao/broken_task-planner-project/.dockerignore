tests/output/
.coverage
htmlcov/
.pytest_cache/

# 日志
logs/
*.log

# 导出文件
exports/

# Git
.git/
.gitignore

# 环境变量（不要打进镜像）
.env

# 文档
*.md
docs/

# CI
.github/
.gitlab-ci.yml
