// ct-sr/script/wwwl.js
import { doms, isDomAvailable, safeCloneAndReplace } from './doms.js';

// 窗宽窗位预设
export const WWWL_PRESETS = [
  { name: '脑组织', ww: 80, wl: 40 },
  { name: '胸部-纵膈', ww: 400, wl: 40 },
  { name: '胸部-肺窗', ww: 1500, wl: -600 },
  { name: '腹部-肝脾', ww: 150, wl: 30 },
  { name: '腹部-肾', ww: 250, wl: 30 },
  { name: '骨窗', ww: 2000, wl: 300 },
  { name: '脊椎软组织', ww: 300, wl: 40 },
  { name: '自定义', ww: 400, wl: 40 }
];

export const DefaultWWWL = [400, 40];

// 防止重复初始化
let wwwlInitialized = false;

// 初始化窗预设功能
export function initWWWLDisplay() {
  console.log('初始化窗宽窗位功能...');
  
  if (wwwlInitialized) {
    console.log('窗预设已初始化，跳过');
    return;
  }
  
  // 检查必要的DOM元素（容错版，返回缺失元素列表）
  const missingElements = validateRequiredElements();
  if (missingElements.length > 0) {
    console.error('必要的DOM元素缺失，无法初始化窗预设:', missingElements);
    return;
  }
  
  // 初始化输入框（增加容错判断）
  if (isDomAvailable(doms.wwInput)) {
    doms.wwInput.value = DefaultWWWL[0];
  }
  if (isDomAvailable(doms.wlInput)) {
    doms.wlInput.value = DefaultWWWL[1];
  }
  
  // 初始化预设下拉菜单
  initPresetSelector();
  
  // 设置事件监听
  setupEventListeners();
  
  wwwlInitialized = true;
  console.log('✅ 窗预设功能初始化完成');
}

// 应用窗宽窗位
function applyWWWL() {
  console.log('应用窗宽窗位...');
  
  const ww = parseInt(doms.wwInput?.value) || 400;
  const wl = parseInt(doms.wlInput?.value) || 40;
  
  try {
    const element = doms.root;
    if (!isDomAvailable(element)) {
      console.warn('图像元素未找到');
      return;
    }
    
    // 增加cornerstone存在判断
    if (window.cornerstone) {
      const viewport = cornerstone.getViewport(element);
      if (viewport) {
        viewport.voi.windowWidth = ww;
        viewport.voi.windowCenter = wl;
        cornerstone.setViewport(element, viewport);
        console.log('✅ 窗宽窗位已应用: WW=' + ww + ', WL=' + wl);
      }
    } else {
      console.warn('cornerstone未加载，无法应用窗宽窗位');
    }
    
  } catch (error) {
    console.error('应用窗宽窗位失败:', error);
  }
}

// 验证必要的DOM元素（返回缺失元素列表，更友好）
function validateRequiredElements() {
  const requiredElements = [
    { key: 'wwInput', id: 'ww-input' },
    { key: 'wlInput', id: 'wl-input' },
    { key: 'applyWWWL', id: 'apply-btn' },
    { key: 'presetWWWL', id: 'presetWWWL' }
  ];
  
  const missing = [];
  for (const { key, id } of requiredElements) {
    if (!isDomAvailable(doms[key])) {
      console.error(`DOM元素缺失: ${key} (${id})`);
      missing.push({ key, id });
    }
  }
  
  return missing;
}

// 初始化预设选择器
function initPresetSelector() {
  console.log('初始化预设选择器...');
  
  // 清空现有选项（增加容错）
  if (!isDomAvailable(doms.presetWWWL)) {
    console.warn('预设选择器元素未找到，跳过初始化');
    return;
  }
  
  doms.presetWWWL.innerHTML = '';
  
  // 添加预设选项
  WWWL_PRESETS.forEach((preset, index) => {
    const option = document.createElement('option');
    option.value = index;
    option.textContent = preset.name;
    doms.presetWWWL.appendChild(option);
  });
  
  // 设置默认选择
  doms.presetWWWL.selectedIndex = 0;
  console.log('预设选择器初始化完成，选项数量:', WWWL_PRESETS.length);
}

// 设置事件监听器
function setupEventListeners() {
  console.log('设置窗预设事件监听器...');
  
  // 移除可能存在的旧监听器（使用健壮的替换方法）
  removeEventListeners();
  
  // 应用按钮点击事件（增加容错）
  if (isDomAvailable(doms.applyWWWL)) {
    doms.applyWWWL.addEventListener('click', handleApplyWWWL);
  }
  
  // 预设选择变化事件（增加容错）
  if (isDomAvailable(doms.presetWWWL)) {
    doms.presetWWWL.addEventListener('change', handlePresetChange);
  }
  
  console.log('✅ 窗预设事件监听器设置完成');
}

// 移除事件监听器（使用safeCloneAndReplace，避免报错）
function removeEventListeners() {
  const elements = ['applyWWWL', 'presetWWWL', 'wwInput', 'wlInput'];
  
  elements.forEach(elementName => {
    const oldElement = doms[elementName];
    const newElement = safeCloneAndReplace(oldElement);
    // 若替换成功，更新doms中的引用
    if (isDomAvailable(newElement)) {
      doms[elementName] = newElement;
    }
  });
}

// 处理预设变化
function handlePresetChange() {
  if (!isDomAvailable(doms.presetWWWL)) return;
  
  const selectedIndex = doms.presetWWWL.selectedIndex;
  console.log('预设变更:', selectedIndex);
  
  if (selectedIndex >= 0 && selectedIndex < WWWL_PRESETS.length) {
    const preset = WWWL_PRESETS[selectedIndex];
    
    // 更新输入框显示（增加容错）
    if (isDomAvailable(doms.wwInput)) {
      doms.wwInput.value = preset.ww;
    }
    if (isDomAvailable(doms.wlInput)) {
      doms.wlInput.value = preset.wl;
    }
    
    // 如果是自定义预设，不自动应用
    if (preset.name !== '自定义') {
      console.log(`应用预设: ${preset.name}`);
      applyWWWL();
    }
  }
}

// 处理应用按钮点击
function handleApplyWWWL() {
  const ww = parseFloat(doms.wwInput?.value || '400');
  const wl = parseFloat(doms.wlInput?.value || '40');
  
  console.log('手动应用窗宽窗位:', { ww, wl });
  
  if (isNaN(ww) || isNaN(wl)) {
    alert('请输入有效的窗宽窗位数值');
    return;
  }
  
  if (ww <= 0) {
    alert('窗宽必须大于0');
    return;
  }
  
  applyWWWL();
}

// 清理函数
export function cleanupWWWL() {
  removeEventListeners();
  wwwlInitialized = false;
  console.log('窗预设功能已清理');
}

// 🔥 移除自身的自动初始化（统一由init.js管理，避免重复和时序问题）
