// ct-sr/script/file.js
import { doms, isDomAvailable, safeCloneAndReplace } from './doms.js';
import { updateImageInfo } from './info.js';
import { syncImageSizeToWWWL } from './wwwl.js';

// 确保全局状态存在
window._ctsr = window._ctsr || {};
window._ctsr.srState = window._ctsr.srState || {
  fileOpened: false,
  imageHW: null,
  originalImageHW: null,
  currentImage: null
};

// 导出状态
export const fileState = window._ctsr.srState;

// 文件加载事件监听器数组
const fileLoadCallbacks = [];

// 支持的图像格式
const SUPPORTED_FORMATS = {
  // DICOM格式
  '.dcm': 'DICOM',
  '.dicom': 'DICOM',
  // 常见图像格式
  '.png': 'PNG',
  '.jpg': 'JPEG',
  '.jpeg': 'JPEG',
  '.bmp': 'BMP',
  '.tiff': 'TIFF',
  '.tif': 'TIFF',
  '.gif': 'GIF',
  '.webp': 'WEBP',
  '.ico': 'ICO',
  '.svg': 'SVG'
};

// 初始化文件处理器
export function initFileHandlers() {
  console.log('初始化文件处理器...');
  
  // 增加容错判断：元素是否可用
  if (!isDomAvailable(doms.openDicom)) {
    console.error('❌ 文件输入元素不可用');
    return false;
  }
  
  // 移除旧事件监听器（使用健壮的safeCloneAndReplace，避免parentNode null）
  const newInput = safeCloneAndReplace(doms.openDicom);
  // 若替换成功，更新doms引用并绑定事件
  if (isDomAvailable(newInput)) {
    doms.openDicom = newInput;
    newInput.addEventListener('change', handleFileSelect);
    console.log('✅ 文件输入事件已绑定，支持格式:', Object.keys(SUPPORTED_FORMATS).join(', '));
  } else {
    console.warn('❌ 文件输入元素替换失败，无法绑定事件');
    return false;
  }
  
  return true;
}

// 添加状态监控，防止意外重置
export function monitorFileState() {
  setInterval(() => {
    if (window._ctsr && window._ctsr.srState) {
      const fileState = window.getFileState ? window.getFileState() : null;
      const srState = window._ctsr.srState;
      
      // 如果文件模块说有文件，但超分模块说没有，自动修复
      if (fileState && fileState.fileOpened && !srState.fileOpened) {
        console.warn('检测到状态不同步，自动修复...');
        srState.fileOpened = true;
        srState.imageHW = fileState.imageHW;
        srState.originalImageHW = fileState.imageHW;
        // 增加：判断updateButtonState是否存在，避免报错
        if (window.updateButtonState) {
          updateButtonState();
        }
      }
    }
  }, 1000); // 每秒检查一次
}

// 获取文件扩展名
function getFileExtension(filename) {
  return filename.slice((filename.lastIndexOf(".") - 1 >>> 0) + 1).toLowerCase();
}

// 获取完整扩展名（包含点）
function getFullExtension(filename) {
  const ext = filename.slice((filename.lastIndexOf(".") - 1 >>> 0) + 2);
  return ext ? '.' + ext.toLowerCase() : '';
}

// 验证文件格式
function validateFileFormat(filename) {
  const ext = getFullExtension(filename);
  if (ext in SUPPORTED_FORMATS) {
    return {
      isValid: true,
      format: SUPPORTED_FORMATS[ext],
      extension: ext
    };
  }
  return {
    isValid: false,
    format: null,
    extension: ext
  };
}

// 处理文件选择
function handleFileSelect(e) {
  const file = e.target.files[0];
  if (!file) return;
  
  console.log('选择文件:', file.name, '类型:', file.type, '大小:', formatFileSize(file.size));
  
  // 验证文件类型
  const validation = validateFileFormat(file.name);
  if (!validation.isValid) {
    alert(`不支持的文件格式: ${validation.extension}\n请选择以下格式:\n${Object.keys(SUPPORTED_FORMATS).join(', ')}`);
    e.target.value = '';
    return;
  }
  
  // 根据文件类型选择加载方式
  if (validation.extension === '.dcm' || validation.extension === '.dicom') {
    loadDicomFile(file);
  } else {
    loadCommonImage(file, validation.format);
  }
}

// 加载DICOM文件
function loadDicomFile(file) {
  try {
    console.log('加载DICOM文件:', file.name);
    
    // 检查必要的库
    if (!window.cornerstone) {
      throw new Error('cornerstone库未加载');
    }
    
    if (!window.cornerstoneWADOImageLoader) {
      throw new Error('cornerstoneWADOImageLoader库未加载');
    }
    
    if (!window.cornerstoneWADOImageLoader.wadouri) {
      throw new Error('cornerstoneWADOImageLoader.wadouri未初始化');
    }
    
    if (!window.cornerstoneWADOImageLoader.wadouri.fileManager) {
      throw new Error('文件管理器未初始化');
    }
    
    // 使用文件管理器添加文件
    const imageId = window.cornerstoneWADOImageLoader.wadouri.fileManager.add(file);
    
    // 加载并显示图像
    cornerstone.loadImage(imageId).then(
      image => {
        displayDicomImage(image, file.name);
      },
      error => {
        console.error('加载DICOM图像失败:', error);
        handleImageError('加载DICOM图像失败', error, 'DICOM');
      }
    );
    
  } catch (error) {
    console.error('DICOM文件处理错误:', error);
    handleImageError('处理DICOM文件时出错', error, 'DICOM');
  }
}


function ensureWebImageLoaderRegistered() {
  // 我们使用原生JS加载图片，无需注册任何加载器
  return true;
}



// 🔥 终极版：原生JS加载PNG/JPG，无任何第三方依赖，彻底解决报错
function loadCommonImage(file, format) {
  try {
    console.log(`加载${format}图像:`, file.name);
    
    if (!window.cornerstone) {
      throw new Error('cornerstone库未加载');
    }

    // 原生Image对象加载图片（核心：无任何加载器依赖）
    const reader = new FileReader();
    reader.onload = function(e) {
      const img = new Image();
      img.onload = function() {
        // 创建Canvas，将普通图片转为Cornerstone兼容格式
        const canvas = document.createElement('canvas');
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0);

        // 手动构造Cornerstone图像对象（官方标准格式）
        const csImage = {
          imageId: `custom:${file.name}`,
          rows: img.height,
          columns: img.width,
          height: img.height,
          width: img.width,
          slope: 1,
          intercept: 0,
          windowCenter: 128,
          windowWidth: 255,
          minPixelValue: 0,
          maxPixelValue: 255,
          color: true,
          rgba: true,
          columnPixelSpacing: 1,
          rowPixelSpacing: 1,
          // 核心：获取像素数据
          getPixelData: () => ctx.getImageData(0,0,img.width,img.height).data
        };

        // 显示图像（复用你原有函数）
        displayCommonImage(csImage, file, format, e.target.result);
      };

      img.onerror = () => {
        handleImageError(`图片加载失败`, new Error('图片损坏或格式不支持'), format);
      };

      // 加载图片
      img.src = e.target.result;
    };

    reader.readAsDataURL(file);

  } catch (error) {
    console.error(`${format}文件处理错误:`, error);
    handleImageError(`处理${format}文件时出错`, error, format);
  }
}

// 显示常见图像
function displayCommonImage(image, file, format, fileURL) {
  const element = doms.root;
  
  if (!isDomAvailable(element)) {
    handleImageError('图像显示元素未找到', null, format);
    return;
  }
  
  try {
    // 增加cornerstone存在判断
    if (!window.cornerstone) {
      throw new Error('cornerstone库未加载');
    }
    
    // 获取默认视口并显示图像
    const viewport = cornerstone.getDefaultViewportForImage(element, image);
    cornerstone.displayImage(element, image, viewport);
    
    // 提取并更新图像信息
    const imageInfo = extractCommonImageInfo(image, file, format);
    updateImageInfo(imageInfo);
    
    // 更新全局状态
    updateFileState(image, file.name, file.size, format);
    
    // 释放URL（图像已加载完成）
    setTimeout(() => {
      URL.revokeObjectURL(fileURL);
      console.log(`✅ ${format}图像URL已释放`);
    }, 1000);
    
    console.log(`✅ ${format}文件加载成功`);
    
  } catch (error) {
    console.error('显示图像失败:', error);
    // 确保释放URL
    URL.revokeObjectURL(fileURL);
    handleImageError('显示图像失败', error, format);
  }
}

// 提取常见图像信息
function extractCommonImageInfo(image, file, format) {
  console.log(`提取${format}图像信息:`, image);
  
  const info = {
    filename: file.name,
    type: format,
    transfer: '标准图像格式',
    fileSize: file.size || 0
  };
  
  // 提取尺寸信息
  if (image.rows && image.columns) {
    info.dimensions = {
      h: image.rows,
      w: image.columns
    };
  } else if (image.height && image.width) {
    info.dimensions = {
      h: image.height,
      w: image.width
    };
  } else {
    // 尝试从image对象获取
    info.dimensions = {
      h: image.rows || image.height || 0,
      w: image.columns || image.width || 0
    };
  }
  
  // 通用图像信息
  info.commonInfo = {
    mimeType: file.type || 'N/A',
    lastModified: file.lastModified ? new Date(file.lastModified).toLocaleString() : 'N/A',
    fileSize: formatFileSize(file.size)
  };
  
  // 图像统计信息
  try {
    info.imageStats = {
      windowWidth: image.windowWidth || 255,
      windowCenter: image.windowCenter || 128,
      bitDepth: image.bitsAllocated || image.bitsPerPixel || 8
    };
  } catch (error) {
    console.warn('提取图像统计信息失败:', error);
    info.imageStats = {
      windowWidth: 255,
      windowCenter: 128,
      bitDepth: 8
    };
  }
  
  console.log('提取的完整信息:', info);
  return info;
}

// 格式化文件大小
function formatFileSize(bytes) {
  if (bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

// 处理图像错误
function handleImageError(message, error, format) {
  // 构建详细的错误信息
  let errorDetails = `${message}\n`;
  
  if (error && error.message) {
    errorDetails += `错误信息: ${error.message}\n`;
  }
  
  if (error && error.stack) {
    errorDetails += `堆栈跟踪: ${error.stack}\n`;
  }
  
  // 添加系统信息
  errorDetails += `\n系统状态:\n`;
  errorDetails += `- cornerstone: ${!!window.cornerstone}\n`;
  errorDetails += `- cornerstoneWebImageLoader: ${!!window.cornerstoneWebImageLoader}\n`;
  errorDetails += `- cornerstoneWADOImageLoader: ${!!window.cornerstoneWADOImageLoader}\n`;
  
  if (window.cornerstoneWADOImageLoader) {
    errorDetails += `- wadouri: ${!!window.cornerstoneWADOImageLoader.wadouri}\n`;
    if (window.cornerstoneWADOImageLoader.wadouri) {
      errorDetails += `- fileManager: ${!!window.cornerstoneWADOImageLoader.wadouri.fileManager}\n`;
    }
  }
  
  // 检查已注册的图像加载器
  if (window.cornerstone && window.cornerstone.imageLoaders) {
    errorDetails += `- 已注册的图像加载器: ${window.cornerstone.imageLoaders.map(l => l.scheme || '未知').join(', ')}\n`;
  }
  
  // 显示错误信息
  alert(errorDetails);
  
  // 重置文件输入（增加容错）
  if (isDomAvailable(doms.openDicom)) {
    doms.openDicom.value = '';
  }
  
  // 记录错误
  console.error(errorDetails);
}

// 显示DICOM图像
function displayDicomImage(image, filename) {
  const element = doms.root;
  
  if (!isDomAvailable(element)) {
    handleImageError('图像显示元素未找到', null, 'DICOM');
    return;
  }
  
  try {
    // 增加cornerstone存在判断
    if (!window.cornerstone) {
      throw new Error('cornerstone库未加载');
    }
    
    // 获取默认视口并显示图像
    const viewport = cornerstone.getDefaultViewportForImage(element, image);
    cornerstone.displayImage(element, image, viewport);
    
    // 更新图像信息
    updateImageInfo(extractDicomInfo(image, filename));
    
    // 更新全局状态
    updateFileState(image, filename, image.size || 0, 'DICOM');
    
    console.log('✅ DICOM文件加载成功');
    
  } catch (error) {
    console.error('显示图像失败:', error);
    handleImageError('显示图像失败', error, 'DICOM');
  }
}

// 提取DICOM信息
function extractDicomInfo(image, filename) {
  console.log('提取DICOM信息:', image);
  
  const info = {
    filename: filename,
    type: 'DICOM',
    transfer: 'DICOM标准',
    fileSize: image.size || 0
  };
  
  // 提取尺寸信息
  if (image.rows && image.columns) {
    info.dimensions = {
      h: image.rows,
      w: image.columns
    };
  } else if (image.height && image.width) {
    info.dimensions = {
      h: image.height,
      w: image.width
    };
  }
  
  // 尝试提取DICOM元数据
  try {
    if (image.data && typeof image.data.string === 'function') {
      info.dicomInfo = {
        patientID: image.data.string('x00100020') || 'N/A', // Patient ID
        studyID: image.data.string('x00200010') || 'N/A',   // Study ID
        modality: image.data.string('x00080060') || 'N/A',  // Modality
        institution: image.data.string('x00080080') || 'N/A' // Institution
      };
    }
  } catch (error) {
    console.warn('提取DICOM元数据失败:', error);
    info.dicomInfo = {
      patientID: 'N/A',
      studyID: 'N/A',
      modality: 'N/A',
      institution: 'N/A'
    };
  }
  
  // 提取图像统计信息
  try {
    info.imageStats = {
      windowWidth: image.windowWidth || 'N/A',
      windowCenter: image.windowCenter || 'N/A',
      bitDepth: image.bitsAllocated || 'N/A'
    };
  } catch (error) {
    console.warn('提取图像统计信息失败:', error);
    info.imageStats = {
      windowWidth: 'N/A',
      windowCenter: 'N/A',
      bitDepth: 'N/A'
    };
  }
  
  console.log('提取的完整信息:', info);
  return info;
}

// 更新文件状态
function updateFileState(image, filename, fileSize, format) {
  console.log(`更新${format}文件状态到超分模块...`);
  
  // 确保状态正确传递
  if (window._ctsr && window._ctsr.srState) {
    window._ctsr.srState.fileOpened = true;
    window._ctsr.srState.imageHW = [image.rows || image.height, image.columns || image.width];
    window._ctsr.srState.originalImageHW = [image.rows || image.height, image.columns || image.width];
    window._ctsr.srState.currentImage = image;
    window._ctsr.srState.imageFormat = format;
    window._ctsr.srState.fileSize = fileSize;
    
    // 标记状态已同步，防止被重置
    window._ctsr.srState._synced = true;
  }
  
  // 触发回调
  triggerFileLoadedCallbacks({
    image: image,
    filename: filename,
    format: format,
    dimensions: [image.rows || image.height, image.columns || image.width],
    fileSize: fileSize
  });
  syncImageSizeToWWWL(image.columns || image.width, image.rows || image.height); 
  console.log(`✅ ${format}文件状态已同步到超分模块`);
}

// 触发文件加载回调
function triggerFileLoadedCallbacks(fileInfo) {
  fileLoadCallbacks.forEach(callback => {
    try {
      // 确保传递完整的对象
      callback(fileInfo);
    } catch (error) {
      console.error('文件加载回调执行失败:', error);
    }
  });
}

// 注册文件加载回调
export function onFileLoaded(callback) {
  if (typeof callback === 'function') {
    fileLoadCallbacks.push(callback);
    console.log('✅ 注册文件加载回调');
  }
}

// 获取文件状态
export function getFileState() {
  return fileState;
}

// 检查文件是否已加载
export function isFileLoaded() {
  return fileState.fileOpened === true;
}

// 获取当前图像
export function getCurrentImage() {
  return fileState.currentImage;
}

// 获取图像尺寸
export function getImageDimensions() {
  return fileState.imageHW;
}

// 获取图像格式
export function getImageFormat() {
  return fileState.imageFormat || 'UNKNOWN';
}

// 获取支持的文件格式
export function getSupportedFormats() {
  return SUPPORTED_FORMATS;
}
